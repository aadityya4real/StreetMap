# Copy to .env for local development. These values are local-only examples.
POSTGRES_DB=streetmap
POSTGRES_USER=streetmap
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=54329

DATABASE_URL=postgres://streetmap:replace-with-a-local-only-password@127.0.0.1:54329/streetmap?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
